+void
+RoutingProtocol::SetWormholePeer(Ptr<RoutingProtocol> peer)
+{
+    NS_ABORT_MSG_IF(peer == this, "A wormhole needs two distinct protocol objects");
+    m_wormholePeer = peer;
+}
+
+void
+RoutingProtocol::TransferToWormhole(const MessageList& messages, Ipv4Address source)
+{
+    if (!m_wormholeEnabled || !m_wormholePeer || !m_wormholePeer->m_wormholeEnabled)
+    {
+        return;
+    }
+    auto peerNode = m_wormholePeer->GetObject<Node>();
+    if (!peerNode)
+    {
+        return;
+    }
+    MessageList selected;
+    for (const auto& message : messages)
+    {
+        if (message.GetMessageType() == MessageHeader::HELLO_MESSAGE ||
+            message.GetMessageType() == MessageHeader::TC_MESSAGE)
+        {
+            auto key = std::make_pair(message.GetOriginatorAddress(), message.GetMessageSequenceNumber());
+            auto found = m_wormholeSeen.find(key);
+            if (found == m_wormholeSeen.end() || found->second <= Simulator::Now())
+            {
+                m_wormholeSeen[key] = Simulator::Now() + Seconds(30);
+                selected.push_back(message);
+            }
+        }
+    }
+    for (auto it = m_wormholeSeen.begin(); it != m_wormholeSeen.end();)
+    {
+        if (it->second <= Simulator::Now())
+        {
+            it = m_wormholeSeen.erase(it);
+        }
+        else
+        {
+            ++it;
+        }
+    }
+    if (!selected.empty())
+    {
+        ++m_wormholeTransfers;
+        Simulator::ScheduleWithContext(peerNode->GetId(),
+                                       m_wormholeDelay,
+                                       &RoutingProtocol::ReplayWormhole,
+                                       m_wormholePeer,
+                                       selected,
+                                       source);
+    }
+}
+
+void
+RoutingProtocol::ReplayWormhole(MessageList messages, Ipv4Address source)
+{
+    if (!m_wormholeEnabled || !m_ipv4)
+    {
+        return;
+    }
+    m_wormholeReplays += SendSpoofedMessages(messages, source);
+}
+
+uint32_t
+RoutingProtocol::SendSpoofedMessages(const MessageList& messages, Ipv4Address source)
+{
+    uint32_t submissions = 0;
+    for (const auto& item : m_sendSockets)
+    {
+        const int32_t interface = m_ipv4->GetInterfaceForAddress(item.second.GetLocal());
+        if (interface < 0 || !m_ipv4->IsUp(interface))
+        {
+            continue;
+        }
+        Ptr<Packet> packet = Create<Packet>();
+        for (const auto& message : messages)
+        {
+            Ptr<Packet> part = Create<Packet>();
+            part->AddHeader(message);
+            packet->AddAtEnd(part);
+        }
+        PacketHeader olsrHeader;
+        olsrHeader.SetPacketLength(olsrHeader.GetSerializedSize() + packet->GetSize());
+        olsrHeader.SetPacketSequenceNumber(GetPacketSequenceNumber());
+        packet->AddHeader(olsrHeader);
+        Ipv4Address broadcast = item.second.GetLocal().GetSubnetDirectedBroadcast(item.second.GetMask());
+        UdpHeader udp;
+        udp.SetSourcePort(OLSR_PORT_NUMBER);
+        udp.SetDestinationPort(OLSR_PORT_NUMBER);
+        if (Node::ChecksumEnabled())
+        {
+            udp.EnableChecksums();
+            udp.InitializeChecksum(source, broadcast, 17);
+        }
+        packet->AddHeader(udp);
+        Ipv4Header ip;
+        ip.SetSource(source);
+        ip.SetDestination(broadcast);
+        ip.SetProtocol(17);
+        ip.SetTtl(1);
+        ip.SetIdentification(olsrHeader.GetPacketSequenceNumber());
+        ip.SetPayloadSize(packet->GetSize());
+        if (Node::ChecksumEnabled())
+        {
+            ip.EnableChecksum();
+        }
+        packet->AddHeader(ip);
+        packet->AddPacketTag(WormholeReplayTag());
+        Ptr<Socket> socket = Socket::CreateSocket(GetObject<Node>(), Ipv4RawSocketFactory::GetTypeId());
+        socket->SetAttribute("IpHeaderInclude", BooleanValue(true));
+        socket->SetAttribute("Protocol", UintegerValue(17));
+        socket->SetAllowBroadcast(true);
+        socket->BindToNetDevice(m_ipv4->GetNetDevice(interface));
+        if (socket->SendTo(packet, 0, InetSocketAddress(broadcast, 0)) > 0)
+        {
+            ++submissions;
+            m_txPacketTrace(olsrHeader, messages);
+        }
+        socket->Close();
+    }
+    return submissions;
+}
