+/** Simulator-only marker preventing out-of-band replay loops; not serialized on the wire. */
+class WormholeReplayTag : public Tag
+{
+  public:
+    /** @return Runtime type of this packet marker. */
+    static TypeId GetTypeId()
+    {
+        static TypeId tid = TypeId("ns3::olsr::WormholeReplayTag")
+                                .SetParent<Tag>().AddConstructor<WormholeReplayTag>();
+        return tid;
+    }
+    TypeId GetInstanceTypeId() const override { return GetTypeId(); }
+    uint32_t GetSerializedSize() const override { return 1; }
+    void Serialize(TagBuffer buffer) const override { buffer.WriteU8(1); }
+    void Deserialize(TagBuffer buffer) override { (void)buffer.ReadU8(); }
+    void Print(std::ostream& os) const override { os << "wormhole-replay"; }
+};
 
