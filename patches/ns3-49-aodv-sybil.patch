 void
+RoutingProtocol::SendSybilHello(Ptr<Socket> socket,
+                                Ptr<Packet> packet,
+                                Ipv4Address destination,
+                                Ipv4Address identity)
+{
+    if (!m_sybilEnabled || !m_ipv4)
+    {
+        return;
+    }
+
+    if (m_sybilManualSchedule)
+    {
+        UdpHeader udp;
+        udp.SetSourcePort(AODV_PORT);
+        udp.SetDestinationPort(AODV_PORT);
+        if (Node::ChecksumEnabled())
+        {
+            udp.EnableChecksums();
+            udp.InitializeChecksum(identity, destination, 17);
+        }
+        packet->AddHeader(udp);
+        Ipv4Header ip;
+        ip.SetSource(identity);
+        ip.SetDestination(destination);
+        ip.SetProtocol(17);
+        ip.SetTtl(1);
+        ip.SetPayloadSize(packet->GetSize());
+        if (Node::ChecksumEnabled())
+        {
+            ip.EnableChecksum();
+        }
+        packet->AddHeader(ip);
+        auto raw = Socket::CreateSocket(m_ipv4->GetObject<Node>(), Ipv4RawSocketFactory::GetTypeId());
+        raw->SetAttribute("IpHeaderInclude", BooleanValue(true));
+        raw->SetAttribute("Protocol", UintegerValue(17));
+        raw->SetAllowBroadcast(true);
+        raw->BindToNetDevice(socket->GetBoundNetDevice());
+        if (raw->SendTo(packet, 0, InetSocketAddress(destination, 0)) > 0)
+        {
+            m_sybilIdentityTx(identity);
+        }
+        raw->Close();
+    }
+    else if (socket->SendTo(packet, 0, InetSocketAddress(destination, AODV_PORT)) >= 0)
+    {
+        m_sybilIdentityTx(identity);
+    }
+}
+
+Ptr<Packet>
+RoutingProtocol::MakeSybilHello(Ipv4Address identity)
+{
+    RrepHeader hello(0,
+                     0,
+                     identity,
+                     m_seqNo,
+                     identity,
+                     Time(m_allowedHelloLoss * m_helloInterval));
+    auto packet = Create<Packet>();
+    SocketIpTtlTag tag;
+    tag.SetTtl(1);
+    packet->AddPacketTag(tag);
+    packet->AddHeader(hello);
+    packet->AddHeader(TypeHeader(AODVTYPE_RREP));
+    return packet;
+}
+
+void
+RoutingProtocol::SendSybilIdentities()
+{
+    if (!m_sybilEnabled || !m_sybilManualSchedule || !m_ipv4)
+    {
+        return;
+    }
+    for (const auto& [socket, iface] : m_socketAddresses)
+    {
+        const auto destination = iface.GetMask() == Ipv4Mask::GetOnes() ? Ipv4Address("255.255.255.255")
+                                                                       : iface.GetBroadcast();
+        for (uint32_t i = 0; i < m_sybilIdentityCount; ++i)
+        {
+            const Ipv4Address identity(m_sybilFirstAddress.Get() + i);
+            SendSybilHello(socket, MakeSybilHello(identity), destination, identity);
+        }
+    }
+}
