+void
+RoutingProtocol::SendAttackReply(const RreqHeader& request, const RoutingTableEntry& reverse)
+{
+    uint32_t sequence = request.GetDstSeqno();
+    RoutingTableEntry known;
+    if (m_routingTable.LookupRoute(request.GetDst(), known) && known.GetValidSeqNo() &&
+        static_cast<int32_t>(known.GetSeqNo() - sequence) > 0)
+    {
+        sequence = known.GetSeqNo();
+    }
+    sequence += m_attackSequenceBoost;
+    RrepHeader reply(0, 1, request.GetDst(), sequence, request.GetOrigin(), m_myRouteTimeout);
+    Ptr<Packet> packet = Create<Packet>();
+    SocketIpTtlTag ttl;
+    ttl.SetTtl(reverse.GetHop());
+    packet->AddPacketTag(ttl);
+    packet->AddHeader(reply);
+    packet->AddHeader(TypeHeader(AODVTYPE_RREP));
+    Ptr<Socket> socket = FindSocketWithInterfaceAddress(reverse.GetInterface());
+    NS_ASSERT(socket);
+    if (socket->SendTo(packet, 0, InetSocketAddress(reverse.GetNextHop(), AODV_PORT)) >= 0)
+    {
+        m_forgedReply(request.GetDst(), sequence);
+    }
+}
