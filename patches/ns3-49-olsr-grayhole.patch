 } // namespace olsr
 } // namespace ns3
+
+namespace ns3::olsr
+{
+bool
+RoutingProtocol::ShouldAttackDrop()
+{
+    if (!m_attackEnabled || Simulator::Now() < m_attackStart || m_attackDropProbability == 0.0)
+    {
+        return false;
+    }
+    if (m_attackDropProbability == 1.0)
+    {
+        return true;
+    }
+    if (!m_attackRandomVariable)
+    {
+        m_attackRandomVariable = CreateObject<UniformRandomVariable>();
+    }
+    return m_attackRandomVariable->GetValue() < m_attackDropProbability;
+}
+} // namespace ns3::olsr
